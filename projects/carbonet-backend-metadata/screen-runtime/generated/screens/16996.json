      }
    ],
    "sections": [
      {
        "code": "CHALLENGE_STATUS",
        "label": "만료·재전송 상태"
      },
      {
        "code": "CODE_INPUT",
        "label": "일회용 코드 입력"
      },
      {
        "code": "SECURITY_FEEDBACK",
        "label": "안전한 오류·재시도 안내"
      }
    ],
    "fromState": "REQUESTED",
    "responsive": "360px 단일 열과 하단 주요 명령, 768px 요약·입력 분리, 1280px 이상 검토 목록·상세 2열을 사용하며 표는 카드 전환 또는 내부 스크롤로 본문을 넘지 않는다.",
    "screenType": "WORKFLOW",
    "commandCode": "VERIFY_RECOVERY_CHALLENGE",
    "apiContracts": [
      {
        "code": "VERIFY_RECOVERY_CHALLENGE",
        "path": "/api/public/account-recovery/requests/{requestId}/verify",
        "method": "POST",
        "request": "RecoveryChallengeVerification",
        "response": "RecoveryProofIssued",
        "singleUse": true,
        "constantTimeCompare": true
      }
    ],
    "designSystem": "KRDS_GOV",
    "accessibility": "KRDS와 WCAG 2.1 AA를 적용하고 OTP 자동완성, 남은 시간 라이브 영역, 오류 요약·필드 연결, 키보드 초점 복귀, 비색상 상태 표현을 제공한다.",
    "dataContracts": [
      {
        "entity": "ACCOUNT_RECOVERY_REQUEST",
        "atomicUpdates": [
          "attemptCount",
          "consumedAt",
          "state"
        ],
        "optimisticLock": true
      },
      {
        "entity": "ACCOUNT_RECOVERY_PROOF",
        "singleUse": true,
        "ttlRequired": true,
        "storedSecret": "hashOnly"
      },
      {
        "entity": "SECURITY_AUDIT_EVENT",
        "appendOnly": true
      }
    ],
    "exitCondition": "유효한 코드가 한 번만 소비되고 짧은 수명의 단일 목적 복구 증명 해시가 서버에 저장된다. 실패 시 남은 횟수 원문을 과도하게 노출하지 않고 한도 초과 요청을 잠근다.",
    "completionRule": "유효한 코드가 한 번만 소비되고 짧은 수명의 단일 목적 복구 증명 해시가 서버에 저장된다. 실패 시 남은 횟수 원문을 과도하게 노출하지 않고 한도 초과 요청을 잠근다.",
    "entryCondition": "REQUESTED 상태이며 요청 범위, 서버 증명, 액터 권한과 최신 행 버전이 유효해야 한다.",
    "businessPurpose": "사용자가 입력한 일회용 코드는 서버의 해시와 상수시간 비교하고 만료, 사용 여부, 실패횟수, 요청 범위와 속도 제한을 검증한다. 브라우저 상태나 화면에 저장된 코드 비교는 신원증명으로 인정하지 않는다."
  },
