      ],
      "status": "APPROVED",
      "caseCode": "COMPANY_REAPPLICATION_PUBLIC_VALIDATION",
      "assertions": [
        "public HTTP 400",
        "field error code",
        "DB changes 0",
        "new files 0",
        "audit rows 0",
        "admin empty selection HTTP 400",
        "admin invalid action HTTP 400"
      ],
      "preconditions": "반려 신청 조회 성공 후 필수값 또는 증빙이 누락된다."
    }
