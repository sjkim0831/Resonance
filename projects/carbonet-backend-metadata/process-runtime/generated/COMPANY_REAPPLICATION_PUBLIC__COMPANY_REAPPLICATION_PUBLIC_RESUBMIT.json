  "tests": [
    {
      "name": "공개 조회 최소노출·관리 명령 차단",
      "type": "AUTHORITY",
      "steps": [
        "lookup rejected application",
        "inspect response",
        "call admin decision without approver"
      ],
      "status": "APPROVED",
      "caseCode": "COMPANY_REAPPLICATION_PUBLIC_AUTHORITY",
      "assertions": [
        "sensitive fields masked",
        "admin commands hidden",
        "HTTP 401 or 403",
        "DB changes 0"
      ],
      "preconditions": "비로그인 사용자와 비승인 일반 계정이 존재한다."
    },
    {
      "name": "동시 재신청·중복 제출 충돌",
      "type": "EXCEPTION",
      "steps": [
        "send concurrent multipart requests",
        "reread institution",
        "count audit and file rows"
      ],
      "status": "APPROVED",
      "caseCode": "COMPANY_REAPPLICATION_PUBLIC_CONFLICT",
      "assertions": [
        "one success",
        "one HTTP 409",
        "single R->A transition",
        "single audit version",
        "no duplicate files"
      ],
      "preconditions": "같은 R 상태 신청과 두 개의 동시 요청이 준비된다."
    },
    {
      "name": "반려 기업 재신청·승인 정상 릴레이",
      "type": "HAPPY_PATH",
      "steps": [
        "GET rejected application",
        "edit allowed fields",
        "attach evidence",
        "POST resubmit",
        "DB reread A",
        "login master approver",
        "GET company approval page",
        "POST action approve",
        "DB reread P"
      ],
      "status": "APPROVED",
      "caseCode": "COMPANY_REAPPLICATION_PUBLIC_HAPPY",
      "assertions": [
        "public HTTP 200",
        "state R->A",
        "audit version +1",
        "evidence count >=1",
        "change hash 64",
        "admin success true",
        "result approved",
        "selectedIds contains insttId",
        "state A->P"
      ],
      "preconditions": "전용 테스트 기업 신청 상태 R, 신규 증빙 파일, 신청자와 승인자 계정이 존재한다."
    },
    {
      "name": "다른 프로젝트·기업 신청 변조 차단",
      "type": "ISOLATION",
      "steps": [
        "lookup company A",
        "forge company B insttId",
        "submit"
      ],
      "status": "APPROVED",
      "caseCode": "COMPANY_REAPPLICATION_PUBLIC_ISOLATION",
      "assertions": [
        "HTTP 404 or 409",
        "project scope retained",
        "company B unchanged",
        "audit rows 0"
      ],
      "preconditions": "두 프로젝트의 서로 다른 기업 신청이 존재한다."
    },
    {
      "name": "DB 실패 시 파일·상태 원자 복구",
      "type": "RECOVERY",
      "steps": [
        "submit with induced DB failure",
        "inspect file store",
        "reread institution and audit",
        "retry valid request"
      ],
      "status": "APPROVED",
      "caseCode": "COMPANY_REAPPLICATION_PUBLIC_RECOVERY",
      "assertions": [
        "first request fails",
        "state remains R",
        "orphan files 0",
        "audit rows 0",
        "retry succeeds once"
      ],
      "preconditions": "파일 저장 뒤 DB 트랜잭션 실패를 재현할 수 있다."
    },
    {
      "name": "증빙 crash-window 자동 대사 안전성",
      "type": "RECOVERY",
      "steps": [
        "acquire local and shared lock",
        "scan at most configured limit",
        "query all candidate object keys before delete",
        "preserve referenced, legacy and symlink files",
        "delete only rechecked unreferenced UUID candidates",
        "record metrics"
      ],
      "status": "APPROVED",
      "caseCode": "TC_COMPANY_REAPPLICATION_EVIDENCE_CRASH_WINDOW",
      "assertions": [
        "actor SYSTEM_RECOVERY",
        "support step COMPANY_REAPPLICATION_EVIDENCE_RECONCILIATION",
        "DB failure deletes 0",
        "minimum age 60 minutes",
        "scan bounded",
        "multi-pod lock held",
        "legacy preserved",
        "symlink preserved"
      ],
      "preconditions": "60분 이상 경과한 신규 UUID 계약 파일, 참조 파일, 레거시 파일, 심볼릭 링크 및 DB 장애 조건이 준비된다."
    },
    {
      "name": "필수값·증빙 정책 위반 차단",
      "type": "VALIDATION",
      "steps": [
        "clear required field",
        "submit",
        "attach forbidden type",
        "submit oversized file",
        "admin POST without insttId and selectedIds",
