#usda 1.0
(
    customLayerData = {
        string animation = "0-240 frames, 24 fps, 10 sec loop"
        string process = "Melting-Holding-Ladler-Buhler-Cooling-Vacuum-Turntable-Trimming"
        string sourceBasis = "2026-07-21 KakaoTalk received files"
        string title = "Woosu Smart Factory V2"
    }
    defaultPrim = "SmartFactory"
    endTimeCode = 240
    framesPerSecond = 24
    metersPerUnit = 0.001
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Z"
)

def Xform "SmartFactory"
{
    def "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </SmartFactory/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.21, 0.27)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }

        def Material "BuhlerBlue"
        {
            token outputs:surface.connect = </SmartFactory/Looks/BuhlerBlue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.22, 0.62)
                float inputs:metallic = 0.55
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "HotZone"
        {
            token outputs:surface.connect = </SmartFactory/Looks/HotZone/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.18, 0.01)
                float inputs:metallic = 0.25
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "SafetyYellow"
        {
            token outputs:surface.connect = </SmartFactory/Looks/SafetyYellow/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.65, 0.01)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.42
                token outputs:surface
            }
        }

        def Material "RunningGreen"
        {
            token outputs:surface.connect = </SmartFactory/Looks/RunningGreen/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.01, 0.5, 0.16)
                color3f inputs:emissiveColor = (0.01, 2, 0.08)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "Floor"
        {
            token outputs:surface.connect = </SmartFactory/Looks/Floor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.065, 0.08)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }

        def Material "Panel"
        {
            token outputs:surface.connect = </SmartFactory/Looks/Panel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.68, 0.73, 0.78)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

    def Xform "ExistingWoosuLayout" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./woosu_layout.usd@
    )
    {
        rel material:binding = </SmartFactory/Looks/Steel>
        float3 xformOp:scale = (1, 1, 0.18)
        double3 xformOp:translate = (0, 0, -500)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

