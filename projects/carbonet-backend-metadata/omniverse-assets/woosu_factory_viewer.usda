    def Scope "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </Factory/Looks/Steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.24, 0.3)
                float inputs:metallic = 0.75
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "MachineBlue"
        {
            token outputs:surface.connect = </Factory/Looks/MachineBlue/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.28, 0.62)
                float inputs:metallic = 0.55
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "SafetyOrange"
        {
            token outputs:surface.connect = </Factory/Looks/SafetyOrange/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.23, 0.025)
                float inputs:metallic = 0.25
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "SafetyYellow"
        {
            token outputs:surface.connect = </Factory/Looks/SafetyYellow/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.64, 0.02)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.42
                token outputs:surface
            }
        }

        def Material "ProcessGreen"
        {
            token outputs:surface.connect = </Factory/Looks/ProcessGreen/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.48, 0.24)
                float inputs:metallic = 0.45
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "FactoryFloor"
        {
            token outputs:surface.connect = </Factory/Looks/FactoryFloor/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.075, 0.09, 0.11)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "LanePaint"
        {
            token outputs:surface.connect = </Factory/Looks/LanePaint/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.7, 0.04)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "SignalRed"
        {
            token outputs:surface.connect = </Factory/Looks/SignalRed/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.28, 0.01, 0.01)
                color3f inputs:emissiveColor = (4, 0.02, 0.01)
                float inputs:metallic = 0
                float inputs:roughness = 0.18
                token outputs:surface
            }
        }
    }

