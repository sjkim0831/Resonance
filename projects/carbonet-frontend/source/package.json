{
  "name": "carbonet-react-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-playwright-responses-output.mjs",
    "generate:system-component-catalog": "node scripts/generate-system-component-catalog.mjs",
    "generate:framework-contract-metadata": "node scripts/generate-framework-contract-metadata.mjs",
    "generate:verification-center-inventory": "node scripts/generate-verification-center-inventory.mjs",
    "generate:process-preview-registry": "node scripts/generate-process-preview-registry.mjs",
    "generate:process-preview-readiness": "node scripts/generate-process-preview-readiness.mjs",
    "register:emission-process-preview": "node scripts/register-emission-process-preview.mjs",
    "qa:emission-live-preview": "node ../../../ops/scripts/resonance-emission-live-preview-pipeline.mjs",
    "pregenerate:screens": "node scripts/verify-portfolio-layout.mjs",
    "postgenerate:screens": "node scripts/verify-portfolio-layout.mjs",
    "verify:portfolio-layout": "node scripts/verify-portfolio-layout.mjs",
    "generate:screens": "node scripts/generate-screen-blueprints.mjs",
    "verify:screen-generator": "node scripts/verify-generated-screen-type-contract.mjs && node scripts/generate-screen-blueprints.mjs --input scripts/fixtures/screen-blueprint-export-v2.example.json --outDir .cache/screen-generator-verification --strict true",
    "verify:screen-generator-scale": "node scripts/verify-screen-generator-scale.mjs",
    "predev": "node scripts/verify-portfolio-layout.mjs && node ../../../ops/scripts/ccus-canonical-source-gate.cjs",
    "dev": "NODE_OPTIONS=\"--max-old-space-size=${CARBONET_NODE_HEAP_MB:-8192} ${NODE_OPTIONS:-}\" vite",
    "prebuild": "node scripts/verify-portfolio-layout.mjs && node ../../../ops/scripts/ccus-canonical-source-gate.cjs",
    "build": "bash ../../../ops/scripts/ccus-build-current.sh",
    "pretypecheck:full": "node scripts/ensure-shared-generated-screen-assets.mjs",
    "typecheck:full": "tsc -p tsconfig.app.json --pretty false",
    "pretypecheck:incremental": "node scripts/ensure-shared-generated-screen-assets.mjs",
    "typecheck:incremental": "tsc -p tsconfig.app.json --incremental --tsBuildInfoFile tsconfig.app.tsbuildinfo --pretty false",
    "preview": "vite preview",
    "audit:component-standardization": "node scripts/component-standardization-audit.mjs",
    "audit:krds-theme-coverage": "node scripts/krds-theme-coverage-audit.mjs",
    "apply:krds-control-classes": "node scripts/apply-krds-control-classes.mjs",
    "audit:framework-contract-metadata": "node scripts/check-framework-contract-metadata.mjs",
    "audit:generated-output": "npm run audit:framework-contract-metadata && node scripts/check-generated-output-governance.mjs",
    "audit:ui-governance": "node scripts/check-ui-governance.mjs",
    "audit:floating-controls": "node scripts/verify-floating-control-safe-zones.mjs",
    "audit:join-mobile-header": "node scripts/verify-join-company-mobile-header-contract.mjs",
    "audit:login-redirect": "node scripts/verify-login-authority-redirect.mjs",
    "audit:customer-journey": "node scripts/check-customer-journey-governance.mjs",
    "audit:route-registry": "node scripts/check-route-registry-uniqueness.mjs",
    "audit:generated-route-family": "node scripts/check-generated-route-family-integrity.mjs",
    "audit:screen-work-context": "node scripts/verify-screen-work-context-integration.mjs",
    "audit:operational-usage-ledger": "node scripts/verify-operational-usage-ledger.mjs",
    "audit:process-preview-registry": "node scripts/verify-process-preview-registry.mjs",
    "test:certificate-pdf-tamper": "node scripts/verify-certificate-pdf-tamper-contract.mjs",
    "lane:05:loop": "bash scripts/run-resonance-lane-05-loop.sh",
    "lane:06:loop": "bash scripts/run-resonance-lane-06-loop.sh",
    "lane:09:loop": "bash scripts/run-resonance-lane-09-loop.sh",
    "test:e2e": "playwright test",
    "test:e2e:admin-recorder-badge": "playwright test e2e/admin-recorder-audit-badge.spec.ts",
    "test:e2e:member-list": "playwright test e2e/member-list.spec.ts",
    "generate:full-screen-smoke": "bash scripts/export-full-screen-smoke-manifest.sh",
    "build:full-screen-quality": "bash scripts/export-full-screen-quality-context.sh && node scripts/build-full-screen-quality-queue.mjs",
    "test:e2e:full-screen-smoke": "bash scripts/run-full-screen-smoke.sh",
    "test:e2e:full-screen-smoke:changed": "FULL_SCREEN_SMOKE_CHANGED_ONLY=true bash scripts/run-full-screen-smoke.sh",
    "test:process-visual-regression": "node scripts/run-source-process-visual-regression.mjs",
    "generate:page-completeness-inventory": "node scripts/generate-page-completeness-inventory.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "html2pdf.js": "^0.14.0",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.8",
    "rolldown-vite": "7.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^5.4.10",
    "vitest": "^3.2.4"
  }
}
