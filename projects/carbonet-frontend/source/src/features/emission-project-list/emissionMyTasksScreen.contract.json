    { "code": "PROCESS_PROGRESS", "name": { "ko": "프로세스 진행 현황", "en": "Process progress" }, "required": true, "helpId": "emission-my-tasks-process-progress" },
    { "code": "RISKS", "name": { "ko": "지연·위험·예외", "en": "Delays, risks and exceptions" }, "required": true, "helpId": "emission-my-tasks-risks" },
    { "code": "HANDOFF_ACTIVITY", "name": { "ko": "최근 인계와 활동", "en": "Recent handoffs and activity" }, "required": true, "helpId": "emission-my-tasks-handoff-activity" },
