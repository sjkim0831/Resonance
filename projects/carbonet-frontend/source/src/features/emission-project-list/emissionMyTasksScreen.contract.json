  "filters": [
    { "code": "runtimeScope", "label": { "ko": "업무 범위", "en": "Work scope" }, "controlType": "FIXED", "source": "runtimeScope.domainCode" },
    { "code": "project", "label": { "ko": "프로젝트", "en": "Project" }, "controlType": "SELECT", "source": "items.projectId" },
    { "code": "period", "label": { "ko": "기간", "en": "Period" }, "controlType": "SELECT", "source": "query.period" },
    { "code": "status", "label": { "ko": "상태", "en": "Status" }, "controlType": "SELECT", "source": "query.status" }
  ],
  "priorityModel": {
    "mode": "CLIENT_ESTIMATE",
    "label": {
      "ko": "화면 추정 우선순위",
      "en": "Screen-estimated priority"
    },
    "disclosure": {
      "ko": "화면 정렬을 돕는 추정값입니다. 실제 처리 가능 여부와 순서는 서버 상태·권한·선행조건을 우선합니다.",
      "en": "This estimate only assists screen sorting. Server state, authority and prerequisites determine actual eligibility and order."
    },
    "factors": [
      { "code": "DEADLINE", "source": "task.dueDate", "rule": "DUE_WINDOW", "weight": 35 },
      { "code": "SERVER_PRIORITY", "source": "task.priority", "rule": "PRIORITY_BAND", "weight": 25 },
      { "code": "OVERDUE_DURATION", "source": "task.dueDate", "rule": "OVERDUE_WINDOW", "weight": 20 },
      { "code": "EXCEPTION", "source": "task.status,task.blockedReason", "rule": "BLOCKED_OR_HAS_REASON", "weight": 10 },
      { "code": "DEPENDENCY_BLOCK", "source": "task.pendingPredecessors", "rule": "HAS_PENDING_PREDECESSORS", "weight": 10 }
    ],
    "bands": { "P0": 80, "P1": 60, "P2": 30, "P3": 0 }
  },
  "supportSurfaces": [
