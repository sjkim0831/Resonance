  "apiPrefix": "/projects/P006/registry-api",
  "maxImportRows": 500,
  "pageSize": 50,
  "intake": {
    "route": "intake.html",
    "table": "equipment_intake",
    "unknownOwnershipAllowed": true,
    "ownershipNotMatchingGate": true,
    "roles": [
      "PROJECT_ADMIN"
    ],
    "sourceImmutable": true,
    "batchAttribution": "POST /intake/attribution",
    "exactRequiresApprovedIdentity": true,
    "blockedReview": {
      "schema": "intake_matching_review",
      "rowCount": 26,
      "decisions": [
        "REFERENCE_MATCH_POSSIBLE",
        "EXISTING_ASSET_MODIFICATION",
        "EXISTING_ASSET_COMBINATION",
        "NEW_ASSET_REQUIRED",
        "EQUIPMENT_INFO_REQUIRED"
      ],
      "originalMatchingImmutable": true,
      "gate": "NEW_ASSET_REQUIRED only permits considering future new model work, not automatic creation"
    }
  }
