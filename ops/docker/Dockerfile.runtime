# Resonance project runtime Dockerfile.
# Build context is prepared by ops/scripts/resonance-k8s-build-deploy-80-v2.sh:
#   carbonet-api.jar
#   lib/
#   ops/config/

ARG RUNTIME_BASE_IMAGE=localhost:5000/carbonet-runtime-base:java21-chrome-noto-v1
FROM ${RUNTIME_BASE_IMAGE} AS extractor
WORKDIR /extract
COPY carbonet-api.jar /extract/carbonet-api.jar

# Keep the 192 MB executable JAR out of the final image history. Deleting a
# file in a later Docker layer does not remove its bytes from the earlier COPY
# layer, so extraction must happen in a disposable stage.
RUN java -Djarmode=tools -jar /extract/carbonet-api.jar extract \
      --launcher --destination /extract/runtime

FROM ${RUNTIME_BASE_IMAGE}
ARG PROJECT_ID=P003

ENV PROJECT_ID=${PROJECT_ID}
ENV JAVA_OPTS="-Xms256m -Xmx512m"
ENV SERVER_PORT=8080

RUN mkdir -p /app/config /app/lib /app/db /app/runtime /opt/reference /var/logs
WORKDIR /app

# Preserve Spring Boot's natural layers. Dependencies and launcher classes are
# stable across normal Java edits, while BOOT-INF/classes is the small changing
# layer. A one-class edit therefore no longer invalidates/transfers all JARs.
COPY --from=extractor /extract/runtime/org/ /app/runtime/org/
COPY --from=extractor /extract/runtime/META-INF/ /app/runtime/META-INF/
COPY --from=extractor /extract/runtime/BOOT-INF/lib/ /app/runtime/BOOT-INF/lib/
COPY --from=extractor /extract/runtime/BOOT-INF/classpath.idx /app/runtime/BOOT-INF/classpath.idx
COPY --from=extractor /extract/runtime/BOOT-INF/layers.idx /app/runtime/BOOT-INF/layers.idx
COPY --from=extractor /extract/runtime/BOOT-INF/classes/ /app/runtime/BOOT-INF/classes/
COPY lib/ /app/lib/
COPY config/ /app/config/

EXPOSE ${SERVER_PORT}
ENTRYPOINT ["sh", "-c", "exec java ${JAVA_OPTS} -cp /app/runtime org.springframework.boot.loader.launch.JarLauncher --spring.config.additional-location=optional:file:/app/config/ --spring.profiles.active=prod --app.project-id=${PROJECT_ID} --server.port=${SERVER_PORT:-8080}"]
