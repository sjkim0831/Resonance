# Resonance project runtime Dockerfile.
# Build context is prepared by ops/scripts/resonance-k8s-build-deploy-80-v2.sh:
#   carbonet-api.jar
#   lib/
#   ops/config/

ARG RUNTIME_BASE_IMAGE=localhost:5000/carbonet-runtime-base:java21-chrome-noto-v1
FROM ${RUNTIME_BASE_IMAGE}
ARG PROJECT_ID=P003

ENV PROJECT_ID=${PROJECT_ID}
ENV JAVA_OPTS="-Xms256m -Xmx512m"
ENV SERVER_PORT=8080

RUN mkdir -p /app/config /app/lib /app/db /app/runtime /opt/reference /var/logs
WORKDIR /app

COPY carbonet-api.jar /app/carbonet-api.jar
COPY lib/ /app/lib/
COPY config/ /app/config/

# Spring Boot's executable JAR otherwise opens hundreds of nested dependency
# archives during every pod start. Extract its launcher layout once while the
# image is built; this preserves the same application and classpath while
# turning runtime class loading into ordinary filesystem reads.
RUN java -Djarmode=tools -jar /app/carbonet-api.jar extract \
      --launcher --destination /app/runtime \
    && rm -f /app/carbonet-api.jar

EXPOSE ${SERVER_PORT}
ENTRYPOINT ["sh", "-c", "exec java ${JAVA_OPTS} -cp /app/runtime org.springframework.boot.loader.launch.JarLauncher --spring.config.additional-location=optional:file:/app/config/ --spring.profiles.active=prod --app.project-id=${PROJECT_ID} --server.port=${SERVER_PORT:-8080}"]
