[Unit]
Description=Carbonet main branch automatic build, migration, and deployment
After=network-online.target
Wants=network-online.target
OnFailure=carbonet-auto-deploy-failure-handler.service

[Service]
Type=oneshot
User=sjkim
WorkingDirectory=/opt/Resonance
ExecStart=/usr/bin/bash /opt/resonance-data/deploy/auto-deploy-main-launcher.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=6G
MemoryMax=8G
OOMScoreAdjust=500

