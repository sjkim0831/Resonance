[Unit]
Description=Resonance nightly full TypeScript contract and 1000-screen regression sweep
After=network-online.target kubelet.service
Wants=network-online.target

[Service]
Type=oneshot
User=sjkim
WorkingDirectory=/opt/Resonance/var/deploy-worktrees/runtime-build
EnvironmentFile=-/etc/resonance/secrets/admin-smoke.env
Environment=FULL_SCREEN_SMOKE_CHANGED_ONLY=false
Environment=FULL_SCREEN_SMOKE_WORKERS=4
Environment=FULL_SCREEN_SMOKE_RETRIES=0
Environment=CARBONET_QA_AUTH_LOCK_TIMEOUT_SECONDS=300
UMask=0077
ExecStart=/usr/bin/bash /opt/Resonance/var/deploy-worktrees/runtime-build/ops/scripts/run-nightly-frontend-contracts.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
