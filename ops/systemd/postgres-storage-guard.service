[Unit]
Description=Protect and verify PostgreSQL Patroni hostPath storage
After=kubelet.service network-online.target

[Service]
Type=oneshot
User=root
Environment=KUBECONFIG=/etc/kubernetes/admin.conf
# Execute the promoted immutable control-plane copy. /opt/Resonance is a
# developer checkout and can intentionally lag the deployment worktree.
ExecStart=/usr/bin/bash /opt/resonance-data/control-plane/bin/postgres-storage-guard.sh

[Install]
WantedBy=multi-user.target
