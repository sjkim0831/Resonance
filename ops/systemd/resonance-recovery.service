[Unit]
Description=Retired duplicate Resonance Kubernetes recovery entrypoint

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'printf "%s\n" "resonance-recovery retired; carbonet-post-reboot-recovery.service owns recovery (mutation=0)"'
RemainAfterExit=yes
StandardOutput=append:/opt/Resonance/var/log/resonance-recovery.log
StandardError=append:/opt/Resonance/var/log/resonance-recovery.log

[Install]
WantedBy=multi-user.target
